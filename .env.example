# Required only when using the DeepSeek generation/UI runtime.
DEEPSEEK_API_KEY=

# Optional runtime overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SCI_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SCI_RAG_DB_PATH=./chroma_db
SCI_RAG_RETRIEVAL_K=12
SCI_RAG_CONTEXT_K=10
# Optional experimental mode. Keep dense for the existing behavior.
SCI_RAG_RETRIEVAL_MODE=dense
# Optional multi-paper source routing. Only a unique high-signal identifier
# routes to one source; ambiguous questions keep the global search.
SCI_RAG_DOCUMENT_ROUTING=false
# Optional deterministic multi-query retrieval for composite questions. The
# original question is always retained; clause variants are bounded and fused
# within the same source route. Keep false until the benchmark/UI A-B passes.
SCI_RAG_QUERY_DECOMPOSITION=false
# Optional same-page parent/window context enrichment. It preserves the ranked
# context slots and records contributing chunk IDs; keep false until UI A/B.
SCI_RAG_PARENT_WINDOW=false
# Experimental born-digital PDF figure evidence. This reads positioned text
# blocks above Figure N captions; it does not run OCR or inspect image pixels.
# Enabling it affects ingestion, so validate with a fresh isolated DB first.
SCI_RAG_SPATIAL_FIGURE_EVIDENCE=false
# Optional evidence-only answer diagnostic. It never reads benchmark gold
# answers, rewrites a response, or retries an API call; review notices are
# shown only when this switch is true.
SCI_RAG_ANSWER_VALIDATION=false
# Explicit formula/PDE/algorithm questions automatically receive a narrow,
# same-source evidence scan. Set false to preserve the pre-Phase-13.3 behavior.
SCI_RAG_FORMULA_EVIDENCE_AUTO=true
# Optional global formula/PDE/algorithm evidence candidate scan. This remains
# off by default; the automatic gate above is preferred for ordinary usage.
SCI_RAG_FORMULA_EVIDENCE=false
SCI_RAG_HYBRID_CANDIDATE_K=50
SCI_RAG_HYBRID_RRF_K=60
# Optional local-only cross-encoder experiment. Requires hybrid mode and a
# pre-cached model; the runtime never downloads it implicitly.
# SCI_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# SCI_RAG_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
# SCI_RAG_RERANKER_BATCH_SIZE=8
# SCI_RAG_RERANKER_MAX_LENGTH=512
# SCI_RAG_RERANKER_DEVICE=cpu
# SCI_RAG_RERANKER_RRF_K=60
# Set HF_ENDPOINT only when your environment explicitly requires a mirror.
# HF_ENDPOINT=
